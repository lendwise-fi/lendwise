# RPC — node provider and keys (spec 0004). URLs are built per network.
# Provider: drpc or infura.
NEXT_PUBLIC_RPC_PROVIDER=drpc
# Browser key: public by nature. Restrict it at the provider (origins, read
# methods, rate caps).
NEXT_PUBLIC_RPC_API_KEY=your_browser_key
# Server key. Never sent to the browser.
RPC_API_KEY=your_server_key
# Infura only: the server key's secret ("Require API Key Secret" on), sent as
# Basic auth. Ignored with any other provider.
# dRPC only: sign each server request with a JWT ("JSON web token" on for the
# server key). Generate an ES256 pair, upload the PUBLIC key to dRPC, then set
# the PRIVATE key here (PEM; literal \n are accepted) and the fingerprint dRPC
# shows for it:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out rpc-jwt-private.pem
#   openssl ec -in rpc-jwt-private.pem -pubout -out rpc-jwt-public.pem
# RPC_JWT_PRIVATE_KEY=
# RPC_JWT_KEY_ID=
# RPC_API_KEY_SECRET=
# Optional: a full URL that replaces the provider's for one network,
# RPC_URL_<SLUG> (RPC_URL_STELLAR, RPC_URL_MONAD, …), with its own optional
# secret in RPC_URL_<SLUG>_SECRET (Basic auth, Infura style).
# The keyless public Soroban RPC for local Blend reads (rate-limited):
# RPC_URL_STELLAR=https://mainnet.sorobanrpc.com

# WalletConnect (optional)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# The Graph API Key (for codegen and subgraph queries)
THEGRAPH_API_KEY=your_thegraph_api_key_here

# Minimum gap between two Soroban RPC calls, in ms. This is what keeps the
# adapter under the Soroban RPC endpoint (server RPC config, Stellar network)
# rate limit — there is no in-process retry, a refused call fails the job and
# QStash re-runs it.
#
# 80 ms suits a 15 req/s endpoint (measured peak: 10 req/s). Budget per full
# cycle, measured at the fetch layer: spot 32 requests (v1) + 41 (v2) every
# 10 min, products 16 + 15 hourly = ~11,300 requests/day for both versions.
# Check that against the plan's daily cap before lowering this.
STELLAR_RPC_MIN_INTERVAL_MS=300
# Solana RPC (server-side only, never sent to the browser). Unset = the public
# mainnet RPC https://api.mainnet-beta.solana.com (100 req/10 s per IP, 40/10 s
# per method; it answers 403 to any request carrying an Origin header, which
# server-side fetch never sends). Solana does not go through the dRPC/Infura
# provider key. Set it to use a paid endpoint; RPC_URL_SOLANA_SECRET is an
# optional Basic-auth secret for it.
RPC_URL_SOLANA=
RPC_URL_SOLANA_SECRET=
# Minimum gap between two Solana RPC calls, in ms. 250 keeps even a burst of
# one method (getTokenAccountsByOwner, 2 calls per wallet) under the public
# per-method limit; lower it on a paid endpoint.
SOLANA_RPC_MIN_INTERVAL_MS=250
# Blend backstop contract addresses — each names its pool factory and reward
# zone, read to discover pools. Only v2.1 is collected (v1/v2 are retired, see
# src/lib/protocols/blend/common/deployments.ts); its mainnet backstop is built
# in, so this is optional and only exists to point at another network.
NEXT_PUBLIC_BACKSTOP_V2_1=
# Retired deployments — read only by their unregistered code.
NEXT_PUBLIC_BACKSTOP_V1=
NEXT_PUBLIC_BACKSTOP_V2=

# Stellar Hubble (BigQuery public dataset `crypto-stellar`) — Blend pool discovery
# and historical state reconstruction (getApyHistory, `pnpm stellar:history`).
# A service account with the BigQuery Job User role; queries bill this project.
GCP_PROJECT=your_gcp_project_id
# base64 of the service-account JSON key: `base64 -i key.json | tr -d '\n'`
GCP_SERVICE_ACCOUNT_BASE64=
# Optional. Per-call ceiling on bytes billed by a history reconstruction
# (default 20 GiB): over it, BigQuery refuses the job and the call reports
# failures instead of spending. Price a window first with `--dry-run`.
HUBBLE_MAX_BYTES_BILLED=

# Stellar wallet sign-in (SEP-10).
# Secret key (S…) of the account that signs the challenges. Any fresh keypair:
# it never needs funding, the challenge is never submitted to the network.
STELLAR_SEP10_SIGNING_SECRET=
# HMAC key for the httpOnly session cookies — different from the signing secret.
# Keys both wallet sessions, `stellar_session` and the Sign-In With Solana
# `solana_session` (one derived key each).
# REQUIRED in production: `openssl rand -base64 48`
STELLAR_SESSION_SECRET=
# Extra hosts allowed for wallet sign-in, Stellar and Solana (comma-separated), e.g. a custom domain attached to a preview branch
# STELLAR_SIGN_IN_EXTRA_HOSTS=
# Sign-in follows NEXT_PUBLIC_NETWORK (below), and each challenge is bound to
# the host the request reached (lendwise.fi, or a preview's own host) — no
# domain setting.
# Optional Horizon override. Defaults to the Horizon of the current network
# (NEXT_PUBLIC_NETWORK below): horizon.stellar.org on mainnet,
# horizon-testnet.stellar.org on testnet. Used for the multisig signers at
# sign-in, wallet holdings, and the bridge's ChangeTrust and preflight. Ignored,
# with a warning, when it points at the other network's public Horizon.
STELLAR_HORIZON_URL=
# Network of this deployment: mainnet or testnet. Forced to mainnet in
# production. Unset or unknown: testnet on a Vercel preview, mainnet anywhere
# else (local dev, CI). Drives SEP-10, the wallet kit, Horizon reads and the
# CCTP bridge with its EVM source chains. Market data (Blend) always reads pubnet.
NEXT_PUBLIC_NETWORK=mainnet

# Yield Optimizer API
OPTIMIZER_API_URL=https://optimizer.lendwise.fi

# PostgreSQL (Neon) — pooled URL for the app runtime
DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# PostgreSQL (Neon) — direct (unpooled) URL for drizzle-kit migrations
DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Upstash Redis — rate limiting for the PUBLIC endpoints (/api/graphql, /api/optimizer,
# /api/auth/stellar), and the shared store for Stellar sign-in (one-time challenge
# nonces, session revocation).
# Optional locally and in CI: when unset, the limiter is a no-op that allows every
# request and sign-in state lives in memory. REQUIRED in production — without it the
# public endpoints run with no rate limit (logged, by design: availability outranks
# enforcement) and Stellar sign-in refuses to run (503): single-use challenges
# cannot be enforced across serverless instances without a shared store.
UPSTASH_REDIS_REST_URL=https://<name>-<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# QStash — signature verification for the cron-driven pipeline. Every /api/yield/*
# job verifies the incoming request against these keys and returns 401 without
# them, so an unset pair means the whole APY pipeline silently stops ingesting.
# Both are required: QStash rotates between current and next.
# Copy them from the Upstash console → QStash → Request Builder / Signing keys.
QSTASH_CURRENT_SIGNING_KEY=sig_xxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxx

# ─── SCF #45 Tranche 2 — staging only (ignored when VERCEL_ENV=production) ───
# Stellar address served by the staging fixture adapter (known positions and weights)
STELLAR_RISK_FIXTURE_ADDRESS=
# "1" registers the stellar_fixture yield adapter (rates, catalogue, history of a
# fixture Stellar venue). Outside production only: ignored when VERCEL_ENV=production.
# It writes catalogue and hourly rows, so only against an isolated database.
STELLAR_YIELD_FIXTURE=
# Comma-separated productIds whose price is removed from the health factor price map
RISK_DROP_PRICE_KEYS=
# All three are ignored when VERCEL_ENV=production; STELLAR_RISK_FIXTURE_ADDRESS also applies in local dev when set.

# ─── SCF #45 Tranche 3 — CCTP bridge EVM → Stellar ───────────────────────────
# Kill switch for NEW transfers (quote and creation), read on the server only.
# Unset: on for testnet, OFF for mainnet. Mainnet opens only with "1"; testnet
# pauses only with "0". Paused, the page shows a notice instead of the form;
# transfers already in progress can still be resumed, imported and minted.
CCTP_BRIDGE_ENABLED=
# Per-transfer cap in USDC, enforced server-side. Unset: 1000 on mainnet, no cap on testnet.
CCTP_MAX_AMOUNT_USDC=
# Fast Transfer is used when Circle's quote is at most this many bps (default 5), else Standard.
CCTP_FAST_MAX_FEE_BPS=
